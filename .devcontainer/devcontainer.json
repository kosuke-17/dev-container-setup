{
  // ★要編集: 導入先リポジトリ名に合わせる（VS Code のウィンドウ表示名になるだけ）
  "name": "claude-sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Tokyo}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  // init-firewall.sh (iptables/ipset) の実行に必要な権限
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  // --dangerously-skip-permissions はrootでは拒否されるため非rootユーザーが必須
  "remoteUser": "node",
  "mounts": [
    // シェル履歴と ~/.claude（認証トークン・設定）をリビルド後も保持。
    // ★要編集(任意): 先頭のプレフィックスをリポジトリ名にすると
    // `docker volume ls` でどのプロジェクトのものか判別しやすい
    "source=claude-sandbox-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-sandbox-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    // グローバルCLAUDE.mdだけをread-onlyで共有。
    // ~/.claude 丸ごとのマウントはホスト認証情報が漏れるため行わない。
    // ホストに ~/.claude/CLAUDE.md が無いとコンテナ作成に失敗するため、
    // 使わない場合はこの1行を削除する
    "source=${localEnv:HOME}/.claude/CLAUDE.md,target=/home/node/.claude/CLAUDE.md,type=bind,readonly",
    // .devcontainer 自体をread-onlyで上書きマウントする。
    // workspaceMountがリポジトリ全体をrwでマウントするため、対策がないと
    // コンテナ内から devcontainer.json / init-firewall.sh を書き換えられ、
    // 次回リビルド時に任意のホストディレクトリをマウントさせる等に悪用できてしまう。
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  // workspaceMount / workspaceFolder は指定せず、Dev Containers のデフォルトである
  // /workspaces/<リポジトリ名> にマウントさせる。
  // skill や CLAUDE.md がホストの絶対パスを前提にしている場合だけ、
  // workspaceMount でホストと同一の絶対パスに固定する必要がある。

  // ★要編集(任意): dev サーバー等をホストのブラウザから見たい場合にポートを追加する
  // "forwardPorts": [3000],
  // "portsAttributes": { "3000": { "label": "dev server" } },

  // ★要編集(任意): 初回コンテナ作成時に依存関係をインストールしたい場合に指定する
  // "postCreateCommand": "npm install",

  // 起動時にデフォルト拒否のegress firewallを適用する
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
